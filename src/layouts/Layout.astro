---
import '../styles/global.css';

const { lang = 'ar', title = 'لينا العالي', description = '', image = null } = Astro.props;
const dir = lang === 'ar' ? 'rtl' : 'ltr';
---

<!doctype html>
<html lang={lang} dir={dir}>
	<head>
		<meta charset="utf-8" />
		<meta name="viewport" content="width=device-width, initial-scale=1" />
		<!-- بدون صورة في التاب: أيقونة فاضية عشان المتصفح ما يدوّر على favicon.ico -->
		<link rel="icon" href="data:," />
		<link rel="preconnect" href="https://fonts.googleapis.com" />
		<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
		<link
			rel="stylesheet"
			href="https://fonts.googleapis.com/css2?family=Cormorant+Garamond:wght@400;500;600;700&family=El+Messiri:wght@400;500;600;700&display=swap"
		/>
		<title>{title}</title>
		{description && <meta name="description" content={description} />}

		<!-- معاينة الرابط لما ينرسل بالواتساب وغيره: العنوان والوصف والصورة -->
		<meta property="og:type" content="website" />
		<meta property="og:title" content={title} />
		{description && <meta property="og:description" content={description} />}
		<meta property="og:locale" content={lang === 'ar' ? 'ar_AR' : 'en_US'} />
		{image && <meta property="og:image" content={image} />}
		{image && <meta property="og:image:width" content="1200" />}
		{image && <meta property="og:image:height" content="630" />}
		<meta name="twitter:card" content={image ? 'summary_large_image' : 'summary'} />
	</head>
	<body class="min-h-screen antialiased">
		<slot />
	</body>
</html>
