---
import '../styles/global.css';

const { lang = 'ar', title = 'لينا العالي' } = Astro.props;
const dir = lang === 'ar' ? 'rtl' : 'ltr';
---

<!doctype html>
<html lang={lang} dir={dir}>
	<head>
		<meta charset="utf-8" />
		<meta name="viewport" content="width=device-width, initial-scale=1" />
		<!-- بدون صورة في التاب: أيقونة فاضية عشان المتصفح ما يدوّر على favicon.ico -->
		<link rel="icon" href="data:," />
		<link rel="preconnect" href="https://fonts.googleapis.com" />
		<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
		<link
			rel="stylesheet"
			href="https://fonts.googleapis.com/css2?family=Cormorant+Garamond:wght@400;500;600;700&family=El+Messiri:wght@400;500;600;700&display=swap"
		/>
		<title>{title}</title>
	</head>
	<body class="min-h-screen antialiased">
		<slot />
	</body>
</html>
