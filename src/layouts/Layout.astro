---
import '../styles/global.css';

const { lang = 'ar', title = 'لينا العالي', siteName = '', description = '', image = null } = Astro.props;
const dir = lang === 'ar' ? 'rtl' : 'ltr';
---

<!doctype html>
<html lang={lang} dir={dir}>
	<head>
		<meta charset="utf-8" />
		<meta name="viewport" content="width=device-width, initial-scale=1" />
		<!-- شعار الموقع في التاب -->
		<link rel="icon" type="image/svg+xml" href="/favicon.svg" />
		<!-- نسخة PNG للمتصفحات اللي ما تدعم SVG (مثل Safari) -->
		<link rel="icon" type="image/png" sizes="32x32" href="/favicon-32.png" />
		<!-- أيقونة الآيفون لما ينحفظ الموقع على الشاشة الرئيسية -->
		<link rel="apple-touch-icon" href="/apple-touch-icon.png" />
		<link rel="preconnect" href="https://fonts.googleapis.com" />
		<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
		<link
			rel="stylesheet"
			href="https://fonts.googleapis.com/css2?family=Cormorant+Garamond:wght@400;500;600;700&family=El+Messiri:wght@400;500;600;700&display=swap"
		/>
		<title>{title}</title>
		{description && <meta name="description" content={description} />}

		<!-- معاينة الرابط لما ينرسل بالواتساب وغيره: العنوان والوصف والصورة -->
		<meta property="og:type" content="website" />
		{siteName && <meta property="og:site_name" content={siteName} />}
		<meta property="og:title" content={title} />
		{description && <meta property="og:description" content={description} />}
		<meta property="og:locale" content={lang === 'ar' ? 'ar_AR' : 'en_US'} />
		{image && <meta property="og:image" content={image} />}
		{image && <meta property="og:image:width" content="1200" />}
		{image && <meta property="og:image:height" content="630" />}
		<meta name="twitter:card" content={image ? 'summary_large_image' : 'summary'} />
	</head>
	<body class="min-h-screen antialiased">
		<slot />
	</body>
</html>
