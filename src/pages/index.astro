---
import Layout from '../layouts/Layout.astro';
import Navbar from '../components/Navbar.astro';
import Hero from '../components/Hero.astro';
import Divider from '../components/Divider.astro';
import Stats from '../components/Stats.astro';
import Exhibitions from '../components/Exhibitions.astro';
import SelectedWorks from '../components/SelectedWorks.astro';
import About from '../components/About.astro';
import Milestones from '../components/Milestones.astro';
import Contact from '../components/Contact.astro';
import Footer from '../components/Footer.astro';
import { getAbout, getStats, getExhibitions, getSelectedWorks, getAboutArtist, getMilestones, getContact, getImportantLinks } from '../lib/sanity.js';

const about = await getAbout();
const stats = await getStats();
const exhibitions = await getExhibitions();
const selectedWorks = await getSelectedWorks();
const aboutArtist = await getAboutArtist();
const milestones = await getMilestones();
const contact = await getContact();
const importantLinks = await getImportantLinks();
---

<Layout lang="ar" title={`${(about.name_ar || 'لينا العالي').replace(/ـ/g, '')} | فنانة تشكيلية`}>
	<Navbar lang="ar" about={about} />
	<main>
		<Hero lang="ar" about={about} />
		<Divider />
		<Stats lang="ar" stats={stats} />
		<Exhibitions lang="ar" exhibitions={exhibitions} />
		<SelectedWorks lang="ar" selectedWorks={selectedWorks} />
		<About lang="ar" aboutArtist={aboutArtist} />
		<Milestones lang="ar" milestones={milestones} />
		<Contact lang="ar" contact={contact} />
	</main>
	<Footer lang="ar" links={importantLinks} />
</Layout>
