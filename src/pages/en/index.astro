---
import Layout from '../../layouts/Layout.astro';
import Navbar from '../../components/Navbar.astro';
import Hero from '../../components/Hero.astro';
import Divider from '../../components/Divider.astro';
import Stats from '../../components/Stats.astro';
import Exhibitions from '../../components/Exhibitions.astro';
import SelectedWorks from '../../components/SelectedWorks.astro';
import About from '../../components/About.astro';
import { getAbout, getStats, getExhibitions, getSelectedWorks, getAboutArtist } from '../../lib/sanity.js';

const about = await getAbout();
const stats = await getStats();
const exhibitions = await getExhibitions();
const selectedWorks = await getSelectedWorks();
const aboutArtist = await getAboutArtist();
---

<Layout lang="en" title={about.name_en || 'Lina Al-Aali'}>
	<Navbar lang="en" about={about} />
	<main>
		<Hero lang="en" about={about} />
		<Divider />
		<Stats lang="en" stats={stats} />
		<Exhibitions lang="en" exhibitions={exhibitions} />
		<SelectedWorks lang="en" selectedWorks={selectedWorks} />
		<About lang="en" aboutArtist={aboutArtist} />
	</main>
</Layout>
