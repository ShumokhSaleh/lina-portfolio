---
import { pick } from '../lib/sanity.js';

const { lang = 'ar', selectedWorks = {} } = Astro.props;
const isAr = lang === 'ar';

// الكلمة الصغيرة فوق العنوان ثابتة في الكود (العنوان والنص تكتبهم لينا من الاستوديو)
const label = isAr ? 'أعمال مختارة' : 'Selected Works';
const heading = pick(selectedWorks, 'heading', lang);
const intro = pick(selectedWorks, 'intro', lang);

// نخفي الأعمال اللي ما لها اسم باللغة الحالية (ما نخلط العربي في الصفحة الإنجليزية)
// ونعرض ستة بالكثير (نفس حد الاستوديو)
const works = (selectedWorks.works ?? []).filter((work) => pick(work, 'title', lang)).slice(0, 6);

// ألوان البطاقات بالترتيب: كحلي، أزرق، عنابي، ذهبي، أخضر، وبعدها ترجع من الأول (السادسة كحلي)
// البطاقة الذهبية نصها غامق عشان يكون واضح على الخلفية الفاتحة
const colors = [
	'bg-[#0a2535] text-white',
	'bg-[#367f99] text-white',
	'bg-[#76223e] text-white',
	'bg-[#d3b36e] text-ink',
	'bg-[#365a4e] text-white',
];

// عرض البطاقات على الكمبيوتر (الصف مقسوم 12 جزء):
// بطاقتين في كل صف، وحدة عريضة ووحدة أضيق، والعريضة تبدّل جهتها كل صف (مثل التصميم)
// وآخر بطاقة لو بقت لحالها تاخذ الصف كامل
function cardSpan(i) {
	const alone = i === works.length - 1 && i % 2 === 0;
	if (alone) return 'md:col-span-12';
	const row = Math.floor(i / 2);
	const isFirstInRow = i % 2 === 0;
	// الصفوف 1 و 3: العريضة أول | الصف 2: الضيقة أول
	const wideFirst = row % 2 === 0;
	return isFirstInRow === wideFirst ? 'md:col-span-7' : 'md:col-span-5';
}
---

{
	works.length > 0 && (
		<section id="works" aria-label={label} class="mx-auto max-w-7xl px-5 py-10 md:px-10 md:py-14">
			<!-- رأس القسم: العنوان في جهة، والنص التعريفي في الجهة الثانية -->
			<header class="mb-8 md:mb-12">
				<p class="mb-4 text-xs font-medium tracking-wider text-teal md:text-sm">{label}</p>
				<div class="flex flex-col gap-4 md:flex-row md:items-start md:justify-between md:gap-12">
					{heading && <h2 class="max-w-xl text-3xl leading-tight font-medium text-ink md:text-5xl">{heading}</h2>}
					{intro && <p class="max-w-sm text-sm whitespace-pre-line leading-loose text-slate md:mt-2 md:text-base">{intro}</p>}
				</div>
			</header>

			<!-- الجوال: البطاقات تحت بعض | الكمبيوتر: بطاقتين في الصف بعرض مختلف -->
			<ol class="grid gap-4 md:grid-cols-12 md:gap-5">
				{works.map((work, i) => {
					const title = pick(work, 'title', lang);
					const detail = pick(work, 'detail', lang);
					// الرقم 01، 02 … من ترتيب العمل في القائمة
					const number = String(i + 1).padStart(2, '0');

					const alt = pick(work, 'alt', lang) || title;

					// كل البطاقات بنفس الطول، والصورة تكبر لين تعبي وسط البطاقة كاملة بدون قص
					return (
						<li class:list={['relative flex h-72 flex-col overflow-hidden p-4 md:h-80 md:p-6', colors[i % colors.length], cardSpan(i)]}>
							<!-- خطوط جمالية خلف الصورة: دائرة ومربع مايل، رفيعة وشفافة، وتنقص عند حدود البطاقة -->
							<div aria-hidden="true" class="pointer-events-none absolute inset-0">
								<div class="absolute -top-[30%] -end-[10%] aspect-square h-[95%] rounded-full border border-current opacity-25"></div>
								<div class="absolute top-[30%] end-[12%] aspect-square h-[110%] rotate-30 border border-current opacity-20 rtl:-rotate-30"></div>
							</div>

							<span dir="ltr" class="relative self-end font-en text-sm font-semibold lining-nums opacity-60">
								{number}
							</span>

							<!-- الصورة زر: الضغط عليها يفتحها بحجم كامل (lightbox) -->
							<button
								type="button"
								class="lightbox-trigger relative min-h-0 flex-1 cursor-zoom-in py-3"
								data-full={work.fullUrl}
								data-alt={alt}
								aria-label={isAr ? `عرض «${title}» بحجم كامل` : `View “${title}” full size`}
							>
								<img
									src={work.imageUrl}
									alt={alt}
									loading="lazy"
									decoding="async"
									class="h-full w-full object-contain drop-shadow-xl transition-transform duration-300 hover:scale-[1.02]"
								/>
							</button>

							<!-- خط أبيض، وتحته اسم العمل في جهة والمعلومة الإضافية في الجهة الثانية -->
							<div class="relative flex items-end justify-between gap-4 border-t border-current pt-3">
								<h3 class="text-lg font-semibold md:text-xl">{title}</h3>
								{detail && <p class="shrink-0 text-xs opacity-75 md:text-sm">{detail}</p>}
							</div>
						</li>
					);
				})}
			</ol>

			<!-- نافذة العرض بحجم كامل: خلفية غامقة والصورة في النص -->
			<!-- تتسكر بزر ✕ أو بالضغط على الخلفية أو بزر Esc -->
			<!-- التنقل بين الأعمال: زرين على الجوانب، أو أسهم الكيبورد، أو السحب بالإصبع في الجوال -->
			<dialog
				id="lightbox"
				aria-label={isAr ? 'عرض العمل بحجم كامل' : 'Artwork full view'}
				class="m-0 h-full max-h-none w-full max-w-none bg-transparent p-0 backdrop:bg-black/90"
			>
				<div id="lightbox-stage" class="flex h-full w-full items-center justify-center px-4 py-16 md:p-16">
					<img id="lightbox-img" src="" alt="" class="max-h-full max-w-full object-contain shadow-2xl" />
				</div>
				<button
					type="button"
					id="lightbox-close"
					class="absolute top-4 end-4 flex h-11 w-11 items-center justify-center rounded-full bg-white/10 text-2xl text-white transition hover:bg-white/25"
					aria-label={isAr ? 'إغلاق' : 'Close'}
				>✕</button>

				<!-- زر السابق في بداية السطر وزر التالي في نهايته (في العربي ينعكسون تلقائيًا) -->
				<!-- السهم يلف بالعربي عشان يأشر للجهة الصح -->
				{works.length > 1 && (
					<>
						<button
							type="button"
							id="lightbox-prev"
							class="absolute start-2 top-1/2 flex h-11 w-11 -translate-y-1/2 items-center justify-center rounded-full bg-white/10 text-white transition hover:bg-white/25 md:start-4"
							aria-label={isAr ? 'العمل السابق' : 'Previous artwork'}
						>
							<svg viewBox="0 0 24 24" class="size-6 rtl:rotate-180" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true"><path d="M15 6l-6 6 6 6" /></svg>
						</button>
						<button
							type="button"
							id="lightbox-next"
							class="absolute end-2 top-1/2 flex h-11 w-11 -translate-y-1/2 items-center justify-center rounded-full bg-white/10 text-white transition hover:bg-white/25 md:end-4"
							aria-label={isAr ? 'العمل التالي' : 'Next artwork'}
						>
							<svg viewBox="0 0 24 24" class="size-6 rtl:rotate-180" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true"><path d="M9 6l6 6-6 6" /></svg>
						</button>
					</>
				)}
			</dialog>
		</section>
	)
}

<script>
	const dialog = document.getElementById('lightbox');
	const stage = document.getElementById('lightbox-stage');
	const img = document.getElementById('lightbox-img');
	const triggers = [...document.querySelectorAll('.lightbox-trigger')];
	const rtl = document.documentElement.dir === 'rtl';
	let current = 0;

	// نعرض الصورة الصغيرة (المحمّلة من قبل في البطاقة) على طول عشان الشاشة ما تبقى فاضية
	// ونحمّل الكبيرة بالخلفية، وأول ما تجهز نبدّلها
	function show(i) {
		current = (i + triggers.length) % triggers.length;
		const trigger = triggers[current];
		const thumb = trigger.querySelector('img');
		img.src = thumb.currentSrc || thumb.src;
		img.alt = trigger.dataset.alt;

		const full = new Image();
		const index = current;
		full.onload = () => {
			// نتأكد إن الزائر ما انتقل لعمل ثاني قبل لا تخلص الصورة
			if (index === current && dialog.open) img.src = full.src;
		};
		full.src = trigger.dataset.full;
	}

	const next = () => show(current + 1);
	const prev = () => show(current - 1);

	if (dialog) {
		triggers.forEach((btn, i) =>
			btn.addEventListener('click', () => {
				show(i);
				dialog.showModal();
				// نوقف حركة الصفحة اللي ورا النافذة
				document.documentElement.classList.add('overflow-hidden');
			}),
		);

		document.getElementById('lightbox-close').addEventListener('click', () => dialog.close());
		document.getElementById('lightbox-next')?.addEventListener('click', next);
		document.getElementById('lightbox-prev')?.addEventListener('click', prev);

		// الضغط على الخلفية (مو على الصورة أو الأزرار) يسكّر النافذة
		dialog.addEventListener('click', (e) => {
			if (e.target === dialog || e.target === stage) dialog.close();
		});

		// الأسهم: ننتقل للعمل اللي بعده أو قبله (Esc يسكّر تلقائيًا)
		// في العربي الاتجاه معكوس: السهم اليسار = التالي
		dialog.addEventListener('keydown', (e) => {
			if (e.key === 'ArrowRight') rtl ? prev() : next();
			if (e.key === 'ArrowLeft') rtl ? next() : prev();
		});

		// السحب بالإصبع في الجوال: نفس منطق الأسهم
		// لازم تكون الحركة أفقية وأطول من 50 بكسل عشان ما نخلطها مع اللمسة العادية
		let startX = 0;
		let startY = 0;
		dialog.addEventListener('touchstart', (e) => {
			startX = e.touches[0].clientX;
			startY = e.touches[0].clientY;
		}, { passive: true });
		dialog.addEventListener('touchend', (e) => {
			if (triggers.length < 2) return;
			const dx = e.changedTouches[0].clientX - startX;
			const dy = e.changedTouches[0].clientY - startY;
			if (Math.abs(dx) < 50 || Math.abs(dx) < Math.abs(dy)) return;
			const swipedLeft = dx < 0;
			swipedLeft === rtl ? prev() : next();
		});

		// بعد الإغلاق: نرجّع حركة الصفحة، ونفضي الصورة عشان ما تطلع القديمة لحظة الفتح الجاي
		dialog.addEventListener('close', () => {
			document.documentElement.classList.remove('overflow-hidden');
			img.removeAttribute('src');
		});
	}
</script>
