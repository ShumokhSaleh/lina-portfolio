---
import { pick } from '../lib/sanity.js';

const { lang = 'ar', selectedWorks = {} } = Astro.props;
const isAr = lang === 'ar';

// الكلمة الصغيرة فوق العنوان ثابتة في الكود (العنوان والنص تكتبهم لينا من الاستوديو)
const label = isAr ? 'أعمال مختارة' : 'Selected Works';
const heading = pick(selectedWorks, 'heading', lang);
const intro = pick(selectedWorks, 'intro', lang);

// نخفي الأعمال اللي ما لها اسم باللغة الحالية (ما نخلط العربي في الصفحة الإنجليزية)
// ونعرض ستة بالكثير (نفس حد الاستوديو)
const works = (selectedWorks.works ?? []).filter((work) => pick(work, 'title', lang)).slice(0, 6);

// ألوان البطاقات بالترتيب: كحلي، أزرق، عنابي، ذهبي، أخضر، وبعدها ترجع من الأول (السادسة كحلي)
// البطاقة الذهبية نصها غامق عشان يكون واضح على الخلفية الفاتحة
const colors = [
	'bg-[#0a2535] text-white',
	'bg-[#367f99] text-white',
	'bg-[#76223e] text-white',
	'bg-[#d3b36e] text-ink',
	'bg-[#365a4e] text-white',
];

// عرض البطاقات على الكمبيوتر (الصف مقسوم 12 جزء):
// بطاقتين في كل صف، وحدة عريضة ووحدة أضيق، والعريضة تبدّل جهتها كل صف (مثل التصميم)
// وآخر بطاقة لو بقت لحالها تاخذ الصف كامل
function cardSpan(i) {
	const alone = i === works.length - 1 && i % 2 === 0;
	if (alone) return 'md:col-span-12';
	const row = Math.floor(i / 2);
	const isFirstInRow = i % 2 === 0;
	// الصفوف 1 و 3: العريضة أول | الصف 2: الضيقة أول
	const wideFirst = row % 2 === 0;
	return isFirstInRow === wideFirst ? 'md:col-span-7' : 'md:col-span-5';
}
---

{
	works.length > 0 && (
		<section id="works" aria-label={label} class="mx-auto max-w-7xl px-5 py-10 md:px-10 md:py-14">
			<!-- رأس القسم: العنوان في جهة، والنص التعريفي في الجهة الثانية -->
			<header class="mb-8 md:mb-12">
				<p class="mb-4 text-xs font-medium tracking-wider text-teal md:text-sm">{label}</p>
				<div class="flex flex-col gap-4 md:flex-row md:items-start md:justify-between md:gap-12">
					{heading && <h2 class="max-w-xl text-3xl leading-tight font-medium text-ink md:text-5xl">{heading}</h2>}
					{intro && <p class="max-w-sm text-sm whitespace-pre-line leading-loose text-slate md:mt-2 md:text-base">{intro}</p>}
				</div>
			</header>

			<!-- الجوال: البطاقات تحت بعض | الكمبيوتر: بطاقتين في الصف بعرض مختلف -->
			<ol class="grid gap-4 md:grid-cols-12 md:gap-5">
				{works.map((work, i) => {
					const title = pick(work, 'title', lang);
					const detail = pick(work, 'detail', lang);
					// الرقم 01، 02 … من ترتيب العمل في القائمة
					const number = String(i + 1).padStart(2, '0');

					// كل البطاقات بنفس الطول، والصورة تكبر لين تعبي وسط البطاقة كاملة بدون قص
					return (
						<li class:list={['relative flex h-72 flex-col overflow-hidden p-4 md:h-80 md:p-6', colors[i % colors.length], cardSpan(i)]}>
							<!-- خطوط جمالية خلف الصورة: دائرة ومربع مايل، رفيعة وشفافة، وتنقص عند حدود البطاقة -->
							<div aria-hidden="true" class="pointer-events-none absolute inset-0">
								<div class="absolute -top-[30%] -end-[10%] aspect-square h-[95%] rounded-full border border-current opacity-25"></div>
								<div class="absolute top-[30%] end-[12%] aspect-square h-[110%] rotate-30 border border-current opacity-20 rtl:-rotate-30"></div>
							</div>

							<span dir="ltr" class="relative self-end font-en text-sm font-semibold lining-nums opacity-60">
								{number}
							</span>

							<div class="relative min-h-0 flex-1 py-3">
								<img
									src={work.imageUrl}
									alt={pick(work, 'alt', lang) || title}
									loading="lazy"
									decoding="async"
									class="h-full w-full object-contain drop-shadow-xl"
								/>
							</div>

							<!-- خط أبيض، وتحته اسم العمل في جهة والمعلومة الإضافية في الجهة الثانية -->
							<div class="relative flex items-end justify-between gap-4 border-t border-current pt-3">
								<h3 class="text-lg font-semibold md:text-xl">{title}</h3>
								{detail && <p class="shrink-0 text-xs opacity-75 md:text-sm">{detail}</p>}
							</div>
						</li>
					);
				})}
			</ol>
		</section>
	)
}
