---
import { pick } from '../lib/sanity.js';

const { lang = 'ar', stats = [] } = Astro.props;

// نخفي الإحصائيات اللي ما لها رقم أو نص باللغة الحالية
const items = stats.filter((stat) => stat.number != null && pick(stat, 'label', lang));
---

{
	items.length > 0 && (
		<section class="mx-auto max-w-7xl px-5 py-6 md:px-10 md:py-14">
			<!-- الجوال: صفوف بينها خطوط، الرقم في طرف والنص في الطرف الثاني -->
			<!-- الكمبيوتر: ثلاثة أعمدة بدون خطوط، النص بجانب الرقم -->
			<ul class="divide-y divide-line border-y border-line md:grid md:grid-cols-3 md:gap-10 md:divide-y-0 md:border-0">
				{items.map((stat) => (
					<li class="flex items-center justify-between gap-5 py-5 md:justify-start md:py-0">
						<!-- الرقم دائمًا بالخط الإنجليزي ومن اليسار لليمين عشان تظهر "+20" صح -->
						<span dir="ltr" class="font-en text-4xl leading-none font-medium text-wine md:text-7xl">
							{stat.plus && '+'}
							{stat.number}
						</span>
						<span class="text-sm text-slate md:text-lg">{pick(stat, 'label', lang)}</span>
					</li>
				))}
			</ul>
		</section>
	)
}
