---
import { pick } from '../lib/sanity.js';

const { lang = 'ar', aboutArtist = {} } = Astro.props;
const isAr = lang === 'ar';

// الكلمة الصغيرة فوق الاقتباس ثابتة في الكود (الباقي تكتبه لينا من الاستوديو)
const label = isAr ? 'عن الفنانة' : 'About the Artist';
const quote = pick(aboutArtist, 'quote', lang);

// النبذة نص واحد، ولينا تفصل الفقرات بسطر فاضي — فنقسمها فقرات هنا
const bio = pick(aboutArtist, 'bio', lang)
	.split(/\n\s*\n/)
	.map((paragraph) => paragraph.trim())
	.filter(Boolean);

// التكريم يظهر بس إذا فيه سنة واسم باللغة الحالية
const award = aboutArtist.award;
const awardTitle = pick(award, 'title', lang);
const showAward = award?.year && awardTitle;
---

{
	(quote || bio.length > 0) && (
		<section id="about" aria-label={label} class="mx-auto max-w-7xl px-5 py-10 md:px-10 md:py-16">
			<!-- الجوال: كل شي تحت بعض | الكمبيوتر: الاقتباس في جهة والنبذة والتكريم في الجهة الثانية -->
			<!-- عمود الاقتباس أضيق من عمود النبذة (5 من 12) عشان ما يصير فراغ كبير بينهم -->
			<div class="grid gap-8 md:grid-cols-12 md:gap-12">
				<!-- الكلمة الصغيرة + الاقتباس، وتحته خط ذهبي قصير -->
				<div class="md:col-span-5">
					<p class="mb-4 text-xs font-medium tracking-wider text-teal md:text-sm">{label}</p>
					{quote && (
						<>
							<blockquote class="max-w-md text-2xl leading-snug font-medium text-ink md:text-4xl">{quote}</blockquote>
							<div aria-hidden="true" class="mt-6 h-px w-16 bg-gold md:mt-8 md:w-24"></div>
						</>
					)}
				</div>

				<!-- النبذة -->
				<div class="md:col-span-7">
					{bio.length > 0 && (
						<div class="space-y-4 text-sm leading-loose text-slate md:text-base">
							{bio.map((paragraph) => <p>{paragraph}</p>)}
						</div>
					)}

					<!-- التكريم: بين خطين ذهبيين، السنة في جهة والعنوان بجانبها -->
					{showAward && (
						<div class="mt-8 flex items-center gap-5 border-y border-gold/60 py-4 md:gap-6">
							<span dir="ltr" class="font-en text-2xl leading-none font-medium text-wine lining-nums md:text-3xl">
								{award.year}
							</span>
							<span class="text-sm font-medium text-ink md:text-base">{awardTitle}</span>
						</div>
					)}
				</div>
			</div>
		</section>
	)
}
