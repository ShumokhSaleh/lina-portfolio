---
import { pick } from '../lib/sanity.js';
import { exhibitionStatus, statusLabels, formatDateRange } from '../lib/exhibitions.js';

const { lang = 'ar', exhibitions = [] } = Astro.props;
const isAr = lang === 'ar';

// نص الرابط لو لينا حطت رابط بدون اسم المكان
const linkFallback = isAr ? 'زيارة الموقع' : 'Visit';

// نخفي المعارض اللي ما لها عنوان باللغة الحالية (ما نخلط العربي في الصفحة الإنجليزية)
const items = exhibitions.filter((item) => pick(item, 'title', lang));
---

{
	items.length > 0 && (
		<section id="exhibitions" aria-label={isAr ? 'المعارض' : 'Exhibitions'} class="px-4 py-6 md:px-8 md:py-10">
			<ol class="space-y-4 md:space-y-6">
				{items.map((item, i) => {
					const status = exhibitionStatus(item.startDate, item.endDate);
					const dates = formatDateRange(item.startDate, item.endDate);
					const venue = pick(item, 'venue', lang);
					const description = pick(item, 'description', lang);
					// الرقم 01، 02 … من ترتيب المعرض في القائمة
					const number = String(i + 1).padStart(2, '0');

					// الخلفية: تدرّج من أزرق فاتح شوي (يسار) إلى كحلي غامق (يمين)
					return (
						<li class="overflow-hidden rounded-ss-[3rem] bg-ink bg-[linear-gradient(100deg,#0f3149_0%,#0c2a41_35%,#081d2e_65%,#051624_100%)] text-cream md:rounded-ss-[5rem]">
							<!-- الجوال: كل شي تحت بعض | الكمبيوتر: الرقم ← المحتوى ← التاريخ والمكان -->
							<div class="grid gap-5 px-6 pt-8 pb-6 md:grid-cols-[auto_1fr_auto] md:items-center md:gap-12 md:px-14 md:py-11">
								<!-- الرقم (على الجوال يكون في سطر واحد مع الحالة) -->
								<div class="flex items-center justify-between gap-4 md:block">
									<span dir="ltr" class="font-en text-2xl font-semibold text-gold md:text-3xl">
										{number}
									</span>
									{status && (
										<span
											data-exhibition-status
											data-start={item.startDate}
											data-end={item.endDate}
											data-status={status}
											class="text-xs font-medium md:hidden data-[status=current]:text-sky data-[status=past]:text-cream/65 data-[status=upcoming]:text-gold"
										>
											{statusLabels[lang][status]}
										</span>
									)}
								</div>

								<!-- المحتوى -->
								<div>
									{status && (
										<p
											data-exhibition-status
											data-start={item.startDate}
											data-end={item.endDate}
											data-status={status}
											class="mb-2 hidden text-xs font-medium md:block data-[status=current]:text-sky data-[status=past]:text-cream/65 data-[status=upcoming]:text-gold"
										>
											{statusLabels[lang][status]}
										</p>
									)}
									<h2 class="text-3xl leading-tight font-medium text-white md:text-5xl">
										{pick(item, 'title', lang)}
									</h2>
									{description && (
										<p class="mt-3 max-w-3xl text-sm leading-loose whitespace-pre-line text-cream/75 md:mt-4 md:text-base">
											{description}
										</p>
									)}
								</div>

								<!-- التاريخ والمكان (على الجوال: في سطر واحد تحت خط فاصل) -->
								{(dates || venue || item.link) && (
									<div class="flex flex-wrap items-center justify-between gap-x-6 gap-y-3 border-t border-cream/15 pt-4 md:block md:space-y-4 md:border-0 md:pt-0">
										{dates && <p class="text-sm tracking-wider text-gold">{dates}</p>}
										{item.link ? (
											<a
												href={item.link}
												target="_blank"
												rel="noopener"
												class="inline-block border-b border-gold/60 pb-1 text-sm text-gold transition-colors hover:border-cream hover:text-cream"
											>
												{venue || linkFallback} ↗
											</a>
										) : (
											venue && <p class="text-sm text-gold">{venue}</p>
										)}
									</div>
								)}
							</div>
						</li>
					);
				})}
			</ol>
		</section>
	)
}

<script>
	import { exhibitionStatus, statusLabels } from '../lib/exhibitions.js';

	// الموقع يُبنى مرة وحدة، فالحالة ممكن تقدم مع الوقت
	// (مثلًا معرض خلص بعد آخر بناء). هنا نحدّثها في متصفح الزائر حسب تاريخ اليوم
	const lang = document.documentElement.lang === 'en' ? 'en' : 'ar';
	document.querySelectorAll('[data-exhibition-status]').forEach((el) => {
		const status = exhibitionStatus(el.dataset.start, el.dataset.end);
		if (!status) return;
		el.dataset.status = status;
		el.textContent = statusLabels[lang][status];
	});
</script>
